<Window x:Class="WindowChromeNativeTItleBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowChromeNativeTItleBar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        x:Name="RootWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ========================================== -->
        <!-- 通常ボタン用テンプレート（最小化・最大化・トグル） -->
        <!-- ========================================== -->
        <ControlTemplate x:Key="Win11CaptionButtonStyle" TargetType="Button">
            <Border x:Name="LayoutBorder" Width="46" Height="32" Background="Transparent" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="LayoutBorder" Property="Background" Value="#19000000"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="LayoutBorder" Property="Background" Value="#33000000"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ========================================== -->
        <!-- 閉じるボタン専用テンプレート（ホバー時赤） -->
        <!-- ========================================== -->
        <ControlTemplate x:Key="Win11CloseButtonStyle" TargetType="Button">
            <Border x:Name="LayoutBorder" Width="46" Height="32" Background="Transparent" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="LayoutBorder" Property="Background" Value="#FFE81123"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="LayoutBorder" Property="Background" Value="#FFF1707A"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- ウィンドウのスタイル：SingleBorderWindow ＋ WindowChrome -->
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustomTitleBar, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="WindowChrome.WindowChrome">
                        <Setter.Value>
                            <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <DockPanel>
        <!-- ========================================== -->
        <!-- カスタムタイトルバー -->
        <!-- ========================================== -->
        <!-- ========================================== -->
        <!-- カスタムタイトルバー -->
        <!-- ========================================== -->
        <Border Height="32" Background="#FFF3F3F3" DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- タイトル文字列（WindowChromeがnullのときも出たまま） -->
                <TextBlock Text="My .NET 10 App - Hybrid Mode" 
                   Foreground="#FF1E1E1E" VerticalAlignment="Center" Margin="12,0"
                   FontSize="12" TextTrimming="CharacterEllipsis"/>

                <!-- トグルボタン（必要に応じて表示/非表示を切り替え可能） -->
                <Button Grid.Column="1" Width="36" Height="32" 
                Template="{StaticResource Win11CaptionButtonStyle}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="ToggleTitleBarButton_Click"
                ToolTip="タイトルバー切り替え">
                    <Path Data="M3,3 V21 H21 V3 H3 M5,5 H19 V7 H5 V5 M5,9 H19 V19 H5 V9 Z" 
                  Fill="#FF1E1E1E" Width="12" Height="12" Stretch="Uniform"/>
                </Button>

                <!-- コントロールボックス（★ UseCustomTitleBar が False のときは非表示にする） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                    Visibility="{Binding UseCustomTitleBar, Converter={StaticResource BoolToVis}}">

                    <!-- 最小化 -->
                    <Button x:Name="MinimizeButton" Width="46" Height="32" Foreground="#FF1E1E1E" FontSize="10"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE921;"
                    Template="{StaticResource Win11CaptionButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" 
                    Click="Minimize_Click"
                    ToolTip="最小化"/>

                    <!-- 最大化 -->
                    <Button x:Name="MaximizeButton" Width="46" Height="32" Foreground="#FF1E1E1E" FontSize="10"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE922;"
                    Template="{StaticResource Win11CaptionButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" 
                    Click="Maximize_Click"
                    ToolTip="最大化"/>

                    <!-- 閉じる -->
                    <Button x:Name="CloseButton" Width="46" Height="32" Foreground="#FF1E1E1E" FontSize="10"
                    FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;"
                    Template="{StaticResource Win11CloseButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" 
                    Click="Close_Click"
                    ToolTip="閉じる"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツ -->
        <Grid Background="White">
            <TextBlock Text="(.NET 10) WindowChrome + Win32 INI 連携テンプレート" 
                       VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Foreground="#FF666666"/>
        </Grid>
    </DockPanel>
</Window>
